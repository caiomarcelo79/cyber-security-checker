FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/backend:/workspace/security-engine:/workspace

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY security-engine /workspace/security-engine
COPY backend/requirements.txt /workspace/backend/requirements.txt

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /workspace/backend/requirements.txt -e /workspace/security-engine

COPY backend /workspace/backend
COPY workers /workspace/workers

RUN useradd --system --uid 10001 --create-home csc && mkdir -p /workspace/backend/data/reports && chown -R csc:csc /workspace/backend/data
USER csc

WORKDIR /workspace/backend

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
