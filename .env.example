# ==============================================================================
# CYBER-SECURITY-CHECKER — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# --- Ambiente Geral ---
APP_NAME=cyber-security-checker
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Portas de Host (Docker Compose) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Banco de Dados (PostgreSQL 16) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_me
POSTGRES_DB=cybersecuritychecker
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+psycopg://postgres:postgres_dev_password_change_me@localhost:5432/cybersecuritychecker

# --- Fila e Cache (Redis 7 / Celery) ---
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Segurança da Plataforma ---
SECRET_KEY=dev-only-secret-key-replace-in-production-with-64-hex-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Guardrails do Motor de Segurança (Security Engine) ---
BLOCK_PRIVATE_NETWORKS=true
ALLOW_LOCAL_LAB_TARGETS=true
LAB_ALLOWED_HOSTS=lab-target,localhost-lab.internal
HARD_MAX_REQUESTS_PER_SECOND=20
HARD_MAX_CONCURRENCY=10
HARD_MAX_REQUEST_TIMEOUT_SECONDS=30
HARD_MAX_SCAN_TIMEOUT_SECONDS=3600

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1
